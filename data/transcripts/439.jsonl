{"asset_id": 439, "start": 237.4, "end": 238.68, "text": "为我们发声"}
{"asset_id": 439, "start": 239.2, "end": 241.76, "text": "日本川公众研究所"}
{"asset_id": 439, "start": 243.04, "end": 244.84, "text": "川籍北省的人"}
