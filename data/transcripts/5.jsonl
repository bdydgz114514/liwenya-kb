{"asset_id": 5, "start": 0.05, "end": 2.45, "text": "我叫李文亚"}
{"asset_id": 5, "start": 2.45, "end": 7.45, "text": "来研究我对星球制作中的推翻"}
{"asset_id": 5, "start": 7.45, "end": 12.85, "text": "所有行星围绕太阳运及运动轨道"}
{"asset_id": 5, "start": 12.85, "end": 17.05, "text": "太阳位于椭圆的一个焦点上"}
{"asset_id": 5, "start": 17.05, "end": 21.05, "text": "那两个颈鱼是在这个颈鱼的基础上产生的"}
{"asset_id": 5, "start": 21.05, "end": 25.85, "text": "星球围绕太阳运动是椭圆的颈鱼推翻"}
{"asset_id": 5, "start": 25.85, "end": 29.85, "text": "它与那个两个颈鱼就已经被推翻"}
{"asset_id": 5, "start": 25.37, "end": 29.65, "text": "它与那个两个境遇就已经被推翻"}
{"asset_id": 5, "start": 29.65, "end": 33.51, "text": "具有观察能力能够认真观察的"}
{"asset_id": 5, "start": 33.51, "end": 37.69, "text": "一念中太阳从地球的东北方出来"}
{"asset_id": 5, "start": 37.69, "end": 41.57, "text": "它不断地向东南方移动"}
{"asset_id": 5, "start": 41.57, "end": 43.31, "text": "向东南方移动"}
{"asset_id": 5, "start": 225.93, "end": 228.37, "text": "它没有围绕中子星一圈转转"}
{"asset_id": 5, "start": 228.37, "end": 230.31, "text": "也没有围绕中子星一圈分布"}
{"asset_id": 5, "start": 230.31, "end": 233.01, "text": "是平面极客通用派来"}
{"asset_id": 5, "start": 233.01, "end": 234.71, "text": "是观察到的"}
{"asset_id": 5, "start": 234.71, "end": 237.35, "text": "吸引极四个座右的恒星"}
{"asset_id": 5, "start": 237.35, "end": 239.09, "text": "平面极客通用派来"}
{"asset_id": 5, "start": 239.09, "end": 239.81, "text": "比如说木星"}
{"asset_id": 5, "start": 239.81, "end": 241.63, "text": "它吸引极四个卫星"}
{"asset_id": 5, "start": 241.63, "end": 243.23, "text": "极客通用派来"}
{"asset_id": 5, "start": 243.23, "end": 247.09, "text": "它没有围绕星星一圈分布"}
{"asset_id": 5, "start": 247.09, "end": 249.39, "text": "也没有围绕星星一圈转转"}
