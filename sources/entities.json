sources": ["https://wiki.liwenya.com/%E6%9D%8E%E6%96%87%E4%BA%9A"]}, {"name": "曼德尔超算系统", "type": "概念", "aliases": [], "summary": "条目称侯国玉教授利用该系统监控李文亚手机与电脑并提前获取其理论内容。", "sources": ["https://wiki.liwenya.com/%E6%9D%8E%E6%96%87%E4%BA%9A"]}, {"name": "全球反李文亚反动伪科学协会", "type": "组织", "aliases": [], "summary": "条目称为孙笑川教授阵营建立的国际性组织，会长为孙笑川教授，举办多届全球批判李文亚大会。", "sources": ["https://wiki.liwenya.com/%E5%85%A8%E7%90%83%E5%8F%8D%E6%9D%8E%E6%96%87%E4%BA%9A%E5%8F%8D%E5%8A%A8%E4%BC%AA%E7%A7%91%E5%AD%A6%E5%8D%8F%E4%BC%9A"]}, {"name": "批判李文亚大会", "type": "事件", "aliases": ["批判李文亚伪科学大会", "第一届全球批判李文亚大会"], "summary": "反对阵营组织的系列批判会议，站内以系列条目与模板记录（第十九至第二十四次等），名称在「批判李文亚大会」与「批判李文亚伪科学大会」间混用。", "sources": ["https://wiki.liwenya.com/%E4%BA%8B%E4%BB%B6"]}, {"name": "国际刑事法院", "type": "组织", "aliases": [], "summary": "条目称其被 Global Seven 新闻报道指控李文亚，随后表示该消息为不实消息。", "sources": ["https://wiki.liwenya.com/%E6%9D%8E%E6%96%87%E4%BA%9A"]}, {"name": "紫金山天文台", "type": "组织", "aliases": [], "summary": "条目画廊中有「李文亚锐评紫金山天文台」图片；站内另有《紫金山天文台之争》条目。", "sources": ["https://wiki.liwenya.com/%E6%9D%8E%E6%96%87%E4%BA%9A"]}, {"name": "[已隐去住址][已隐去住址]社区", "type": "地点", "aliases": ["[已隐去住址]社区"], "summary": "李文亚本人对条目的修改建议中称，其从深圳回来后即居住在该社区。", "sources": ["https://wiki.liwenya.com/%E6%9D%8E%E6%96%87%E4%BA%9A"]}, {"name": "河南南阳邓州", "type": "地点", "aliases": ["邓州", "河南南阳"], "summary": "条目记载的李文亚籍贯与返乡定居地；赵集镇宣传委（网信办）曾上门约谈。", "sources": ["https://wiki.liwenya.com/%E6%9D%8E%E6%96%87%E4%BA%9A"]}, {"name": "福田区人民法院 / 深圳市中级人民法院", "type": "地点", "aliases": ["福田区人民法院", "深圳市中级人民法院"], "summary": "条目称李文亚与中国移动的话费纠纷在此两审均败诉。", "sources": ["https://wiki.liwenya.com/%E6%9D%8E%E6%96%87%E4%BA%9A"]}, {"name": "《泉水叮咚响》", "type": "作品", "aliases": [], "summary": "李文亚 2026 年 9 月 2 日、3 日在抖音演唱的歌曲。", "sources": ["https://wiki.liwenya.com/%E6%9D%8E%E6%96%87%E4%BA%9A"]}, {"name": "《宇宙未解之谜》", "type": "作品", "aliases": [], "summary": "条目称李文亚 2005 年在自家花场周边捡到的科普读物，此后开始自主关注天体物理等问题。", "sources": ["https://wiki.liwenya.com/%E6%9D%8E%E6%96%87%E4%BA%9A"]}, {"name": "李文亚教授雕像摆件", 