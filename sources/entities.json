mmary": "以肉眼观测日月星辰并配钟表计时，持续记录天象、整理天体运行与太阳结构文稿。", "source": "https://wiki.liwenya.com/%E6%9D%8E%E6%96%87%E4%BA%9A"}, {"date": "2024年上半年", "title": "注册抖音并开始发布理论视频", "summary": "以方言口述形式发布天体运行、引力、旧理论批判、黑体生物等主题视频。", "source": "https://wiki.liwenya.com/%E6%9D%8E%E6%96%87%E4%BA%9A"}, {"date": "2025", "title": "U盘失窃事件（日期不详）", "summary": "存有核心成果的 U 盘被盗，刘建龙、棍母、隐身人先后被指涉案，成为成果归属争议导火索。", "source": "https://wiki.liwenya.com/U%E7%9B%98%E5%A4%B1%E7%AA%83%E4%BA%8B%E4%BB%B6"}, {"date": "2026-05-15", "title": "清醒人格首次出现", "summary": "在视频评论区以第三人称称李文亚为「混沌人格」，指其理论「黑白不分」。", "source": "https://wiki.liwenya.com/%E6%9D%8E%E6%96%87%E4%BA%9A%EF%BC%88%E6%B8%85%E9%86%92%E4%BA%BA%E6%A0%BC%EF%BC%89"}, {"date": "2026-05-28", "title": "清醒人格宣布人格扩张", "summary": "称体内涌现越来越多清醒人格与善良人格，宣称混沌人格的末日将至。", "source": "https://wiki.liwenya.com/%E6%9D%8E%E6%96%87%E4%BA%9A%EF%BC%88%E6%B8%85%E9%86%92%E4%BA%BA%E6%A0%BC%EF%BC%89"}, {"date": "2026-06-01", "title": "获金坤奖", "summary": "条目荣誉表记载当日获金坤奖（物理金坤奖奖杯）。", "source": "https://wiki.liwenya.com/%E6%9D%8E%E6%96%87%E4%BA%9A"}, {"date": "2026-06-04", "title": "清醒人格宣布夺回身体控制权", "summary": "宣称「混沌人格李文亚还能说话吗？」，同日称「闹剧结束了」。", "source": "https://wiki.liwenya.com/%E6%9D%8E%E6%96%87%E4%BA%9A%EF%BC%88%E6%B8%85%E9%86%92%E4%BA%BA%E6%A0%BC%EF%BC%89"}, {"date": "2026-06-09", "title": "获功勋勋章（Pour le Mérite）", "summary": "即蓝色马克斯勋章，条目荣誉表记载。", "source": "https://wiki.liwenya.com/%E6%9D%8E%E6%96%87%E4%BA%9A"}, {"date": "2026-06", "title": "抖音账号被封禁", "summary": "李文亚在视频中称账号被封禁，新注册账号被设为私密。", "source": "https://wiki.liwenya.com/%E6%9D%8E%E6%96%87%E4%BA%9A"}, {"date": "2026-06-10", "title": "发布「别了，李文亚」与「文亚理论说明会」", "summary": "宣告混沌人格时代终结，并称黑体生物是污垢、白体生物是饮料。", "source": "https://wiki.liwenya.com/%E6%9D%8E%E6%96%87%E4%BA%9A%EF%BC%88%E6%B8%85%E9%86%92%E4%BA%BA%E6%A0%BC%EF%BC%89"}, {"date": "2026-06-29", "title": "清醒人格与混沌人格正面冲突", "summary": "互相批判，形成「清醒人格批判混沌人格批判清醒人格」的嵌套结构。", "source": "https://wiki.liwenya.com/%E6%9D%8E%E6%96%87%E4%BA%9A%EF%BC%88%E6%B8%85%E9%86%92%E4%BA%BA%E6%A0%BC%EF%BC%89"}, {"date": "2026-07-03", "title": "清醒人格发布植物叶片气孔理论", "summary": "在「文亚理论说明会」视频中称 400 倍显微镜可见微米级气孔、手机拍照不可能看到。", "source": "https://wiki.liwenya.com/%E6%9D%8E%E6%96%87%E4%BA%9A%EF%BC%88%E6%B8%85%E9%86%92%E4%BA%BA%E6%A0%BC%EF%BC%89"}, {"date": "2026-07", "title": "网信办两次上门约谈", "summary": "有关部门因涉政问题两次上门约谈，督促将新抖音账号设为私密并进行健康宣教。", "source": "https://wiki.liwenya.com/%E6%9D%8E%E6%96%87%E4%BA%9A"}, {"date": "2026-07-12", "title": "混沌人格重新控制身体", "summary": "清醒人格警告网友理性看待，并继续阐述地球北极倾斜方向、太阳运行轨迹理论、痛斥碧桑驾dell。", "source": "https://wiki.liwenya.com/%E6%9D%8E%E6%96%87%E4%BA%9A%EF%BC%88%E6%B8%85%E9%86%92%E4%BA%BA%E6%A0%BC%EF%BC%89"}, {"date": "2026-07-16", "title": "清醒人格称混沌人格理论「是一坨狗屎」", "summary": "试图彻底否定混沌人格的学术成果。", "source": "https://wiki.liwenya.com/%E6%9D%8E%E6%96%87%E4%BA%9A%EF%BC%88%E6%B8%85%E9%86%92%E4%BA%BA%E6%A0%BC%EF%BC%89"}, {"date": "2026-07-17", "title": "114514研究所发布通缉令", "summary": "依据《114514 研究所跨次元违法行为追击条例》通缉李文亚，罪名含盗窃他人科研成果、随地排泄等。", "source": "https://wiki.liwenya.com/%E6%9D%8E%E6%96%87%E4%BA%9A"}, {"date": "2026-07-20", "title": "获天体物理奖", "summary": "条目荣誉表记载奖章实为一级卫国战争勋章。", "source": "https://wiki.liwenya.com/%E6%9D%8E%E6%96%87%E4%BA%9A"}, {"date": "2026-07-25", "title": "清醒人格 vs 混沌人格「终极对决」", "summary": "出现「谁会赢」的终极议题，清醒人格喊话「现在你才是挑战者」。", "source": "https://wiki.liwenya.com/%E6%9D%8E%E6%96%87%E4%BA%9A%EF%BC%88%E6%B8%85%E9%86%92%E4%BA%BA%E6%A0%BC%EF%BC%89"}, {"date": "2026-08-02", "title": "邓州市政府留言工单办结", "summary": "网友留言请社区劝其就医，工单转交赵集镇宣传委（网信办），回电说明约谈与宣教情况后办结。", "source": "https://wiki.liwenya.com/%E6%9D%8E%E6%96%87%E4%BA%9A"}, {"date": "2026-08中旬", "title": "在快手恢复短视频创作", "summary": "发布批判中国移动三部曲，引入新人物金思成教授。", "source": "https://wiki.liwenya.com/%E6%9D%8E%E6%96%87%E4%BA%9A"}, {"date": "2026-08-19前后", "title": "痛批金思成电话骚扰", "summary": "谴责自称「武汉大学生物研究所主任」的金思成，要求逮捕。", "source": "https://wiki.liwenya.com/%E6%9D%8E%E6%96%87%E4%BA%9A"}, {"date": "2026-08-25", "title": "网友发布李文亚讣告 / 李文亚念讣告", "summary": "讣告称其因[已隐去健康信息]白所成）医生研究；李文亚念讣告强调自己还活着。", "source": "https://wiki.liwenya.com/%E6%9D%8E%E6%96%87%E4%BA%9A"}, {"date": "2026-08-26", "title": "紫体生物采访", "summary": "记者用豆包炮制紫体生物理论劝其多吃粗粮，李文亚斥其不成熟。", "source": "https://wiki.liwenya.com/%E6%9D%8E%E6%96%87%E4%BA%9A"}, {"date": "2026-09-02 至 2026-09-03", "title": "演唱《泉水叮咚响》", "summary": "连续两日在抖音演唱该歌曲。", "source": "https://wiki.liwenya.com/%E6%9D%8E%E6%96%87%E4%BA%9A"}], "glossary": [{"term": "文亚宇宙", "definition": "站点自述为「一个互联网亚文化现象及其相关叙事框架」，本质是网络社群现象与创意叙事；站方声明所有内容为社群虚构设定，涉及真实人物的行为均为虚构。", "source": "https://wenyaverse.fandom.com/zh/wiki/%E6%96%87%E4%BA%9A%E5%AE%87%E5%AE%99%E4%B8%96%E7%95%8C%E8%A7%82_Wiki"}, {"term": "李文亚粒子", "definition": "天体向外释放的高速粒子，被认为推动行星运动、产生旋转动能与旋转引力范围，被其提出者用于替代暗物质/暗能量解释。", "source": "https://wenyaverse.fanarchive.co/wiki/%E6%9D%8E%E6%96%87%E4%BA%9A%E7%B2%92%E5%AD%90"}, {"term": "旋转动能 / 旋转引力范围", "definition": "李文亚粒子推动行星运动产生的能量，及其形成的引力范围；该范围向外推斥，用于防止天体碰撞。", "source": "https://wenyaverse.fanarchive.co/wiki/%E6%9D%8E%E6%96%87%E4%BA%9A%E7%B2%92%E5%AD%90"}, {"term": "星球三重引力范围", "definition": "星球由内向外分为吸引力范围、旋转引力范围、外围吸引力范围三层；李文亚据此否定「单一引力拉扯」理论。", "source": "https://wiki.liwenya.com/%E6%98%9F%E7%90%83%E4%B8%89%E9%87%8D%E5%BC%95%E5%8A%9B%E8%8C%83%E5%9B%B4"}, {"term": "文亚四定律", "definition": "能量即动能（E=mv）；能量可创生与毁灭；时间是物质；能量=动能且永远=mv。", "source": "https://wiki.liwenya.com/%E6%96%87%E4%BA%9A%E5%9B%9B%E5%AE%9A%E5%BE%8B"}, {"term": "黑体生物", "definition": "介于微生物与动物之间的特殊生命存在，可寄生于人体多处，被指与衰老、掉牙、视听衰退、皮肤病、[已隐去健康信息]。", "source": "https://wiki.liwenya.com/%E6%9D%8E%E6%96%87%E4%BA%9A"}, {"term": "白体生物", "definition": "黑体生物的无色或乳白色活体形态；年轻人可自然产生、随年龄增长丧失；命名之争中诺贝尔奖委员会部分研究者主张改称「白体」。", "source": "https://wiki.liwenya.com/%E7%99%BD%E4%BD%93%E7%94%9F%E7%89%A9"}, {"term": "混沌人格", "definition": "清醒人格对李文亚本人的称呼，指其占主导的「非理性」人格状态。", "source": "https://wiki.liwenya.com/%E6%9D%8E%E6%96%87%E4%BA%9A%EF%BC%88%E6%B8%85%E9%86%92%E4%BA%BA%E6%A0%BC%EF%BC%89"}, {"term": "清醒人格", "definition": "李文亚体内于 2026 年中期觉醒、自称理性的对立人格，声称能识别并纠正混沌人格的理论错误。", "source": "https://wiki.liwenya.com/%E6%9D%8E%E6%96%87%E4%BA%9A%EF%BC%88%E6%B8%85%E9%86%92%E4%BA%BA%E6%A0%BC%EF%BC%89"}, {"term": "人格内战", "definition": "条目对清醒人格与混沌人格共享同一身体、争夺控制权这一叙事的概括。", "source": "https://wiki.liwenya.com/%E6%9D%8E%E6%96%87%E4%BA%9A%EF%BC%88%E6%B8%85%E9%86%92%E4%BA%BA%E6%A0%BC%EF%BC%89"}, {"term": "批判李文亚大会", "definition": "反对阵营组织的系列批判会议，站内条目分「批判李文亚大会」与「批判李文亚伪科学大会」两种命名（如第十九至第二十四次）。", "source": "https://wiki.liwenya.com/%E4%BA%8B%E4%BB%B6"}, {"term": "金坤奖", "definition": "号称「首届宇宙级奖项」的民间奖项，2026-06-01 授予李文亚，配证书与刻有「只因」防伪标志的奖杯；其真伪之辩存在争议。", "source": "https://wiki.liwenya.com/%E9%87%91%E5%9D%A4%E5%A5%96"}, {"term": "枪毙名单", "definition": "2026 年李文亚公布的反对者名单，含王楚淇、陈人杰、孙笑川、唐振钦等，被视为其极端政治化措辞的代表。", "source": "https://wiki.liwenya.com/%E6%9D%8E%E6%96%87%E4%BA%9A"}, {"term": "吃饭是检验[已隐去健康信息], "definition": "李文亚在念自己讣告时提出的说法，条目引文标注来源为《民科日报》社论。", "source": "https://wiki.liwenya.com/%E6%9D%8E%E6%96%87%E4%BA%9A"}, {"term": "查水表", "definition": "条目使用的网络用语，指有关部门上门约谈/处置；2026 年 7 月李文亚被两次「查水表」。", "source": "https://wiki.liwenya.com/%E6%9D%8E%E6%96%87%E4%BA%9A"}, {"term": "民科", "definition": "条目语境中的「民间科学研究者」，李文亚的职业身份自述之一。", "source": "https://wiki.liwenya.com/%E6%9D%8E%E6%96%87%E4%BA%9A"}, {"term": "教授（文亚宇宙用法）", "definition": "站内对各类人物（含虚构机构与网络人物）的通称头衔，另有《教授列表》汇总；不等于现实高校职称。", "source": "https://wiki.liwenya.com/%E6%95%99%E6%8E%88%E5%88%97%E8%A1%A8"}]}